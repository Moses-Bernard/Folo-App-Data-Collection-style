<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_main">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvCurrentRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Role: "
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvCurrentUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User: "
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnChangeRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Change Role"
        android:background="@drawable/bg_purple_button"
        android:textColor="@color/text_on_button"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnClearData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clear All Data"
        android:background="@drawable/bg_purple_button"
        android:textColor="@color/text_on_button"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:background="@drawable/bg_purple_button"
        android:textColor="@color/text_on_button"/>
</LinearLayout>
