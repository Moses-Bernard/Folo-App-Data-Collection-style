<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register New Woman"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name *"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone Number"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Address"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etLandmark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Landmark"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Area"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etLga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="LGA"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etDob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date of Birth (YYYY-MM-DD)"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etEdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expected Delivery Date (YYYY-MM-DD)"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etGravida"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Gravida"
                android:inputType="number"
                android:background="@drawable/bg_purple_edittext"
                android:padding="12dp"
                android:layout_marginEnd="4dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"/>

            <EditText
                android:id="@+id/etPara"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Para"
                android:inputType="number"
                android:background="@drawable/bg_purple_edittext"
                android:padding="12dp"
                android:layout_marginStart="4dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnCaptureGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capture GPS"
            android:background="@drawable/bg_purple_button"
            android:textColor="@color/text_on_button"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:background="@drawable/bg_purple_button"
            android:textColor="@color/text_on_button"/>
    </LinearLayout>
</ScrollView>
