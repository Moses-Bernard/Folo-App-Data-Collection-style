<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_mauve_gradient">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/back"
        android:background="@drawable/bg_purple_button"
        android:textColor="@color/text_on_button"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Export Data"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Export Format"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp"/>

    <RadioGroup
        android:id="@+id/rgFormat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/rbJson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JSON Format"
            android:textColor="@color/text_primary"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rbCsv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CSV Format"
            android:textColor="@color/text_primary"/>
    </RadioGroup>

    <Button
        android:id="@+id/btnExport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Export Now"
        android:background="@drawable/bg_purple_button"
        android:textColor="@color/text_on_button"
        android:padding="16dp"/>
</LinearLayout>
