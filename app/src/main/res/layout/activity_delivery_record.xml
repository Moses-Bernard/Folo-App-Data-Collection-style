<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record Delivery"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etDelDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Delivery Date (YYYY-MM-DD)"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etDelPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Delivery Place"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etDelOutcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Outcome (Live birth/Stillbirth/Miscarriage)"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etBabyGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Baby Gender"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etBabyWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Baby Weight (kg)"
            android:inputType="numberDecimal"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etComplications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Complications"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <EditText
            android:id="@+id/etAttendant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Attendant Name"
            android:background="@drawable/bg_purple_edittext"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <Button
            android:id="@+id/btnSaveDelivery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Delivery Record"
            android:background="@drawable/bg_purple_button"
            android:textColor="@color/text_on_button"/>
    </LinearLayout>
</ScrollView>
