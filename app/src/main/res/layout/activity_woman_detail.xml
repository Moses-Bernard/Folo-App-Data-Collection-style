<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <TextView
            android:id="@+id/tvDetailPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/tvDetailAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/tvDetailGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS"
            android:textColor="@color/text_secondary"/>

        <TextView
            android:id="@+id/tvDetailRisk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Risk"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnEditWoman"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Edit"
                android:background="@drawable/bg_purple_button"
                android:textColor="@color/text_on_button"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnNavigate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Navigate"
                android:background="@drawable/bg_purple_button"
                android:textColor="@color/text_on_button"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnAddHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Health Check"
            android:background="@drawable/bg_purple_button"
            android:textColor="@color/text_on_button"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnAddVisit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Visit"
            android:background="@drawable/bg_purple_button"
            android:textColor="@color/text_on_button"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnAddDelivery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record Delivery"
            android:background="@drawable/bg_purple_button"
            android:textColor="@color/text_on_button"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visits"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="16dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVisits"
            android:layout_width="match_parent"
            android:layout_height="200dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Schedules"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="16dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSchedules"
            android:layout_width="match_parent"
            android:layout_height="200dp"/>
    </LinearLayout>
</ScrollView>
